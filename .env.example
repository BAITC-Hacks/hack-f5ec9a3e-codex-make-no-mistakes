# Local development only; use deployment-specific credentials for hosting.
DATABASE_URL=postgresql+psycopg://replenishment:local_dev_only@127.0.0.1:55432/replenishment

# Copy to .env and supply your API key; never commit .env.
# Load explicitly from backend/: uv run --env-file ../.env python -m replenishment.cli.calculate --planning-date YYYY-MM-DD
# GPT-4.1 mini supports Responses structured outputs without reasoning-token overhead.
# Standard USD per million tokens; recheck prices when changing models:
# https://developers.openai.com/api/docs/models/gpt-4.1-mini
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_INPUT_PER_MILLION=0.40
OPENAI_OUTPUT_PER_MILLION=1.60
OPENAI_MAX_INPUT_TOKENS=8000
OPENAI_MAX_OUTPUT_TOKENS=512
# Optional escalation model; leave all blank to disable escalation.
OPENAI_STRONG_MODEL=
OPENAI_STRONG_INPUT_PER_MILLION=
OPENAI_STRONG_OUTPUT_PER_MILLION=
OPENAI_STRONG_MAX_INPUT_TOKENS=
OPENAI_STRONG_MAX_OUTPUT_TOKENS=
